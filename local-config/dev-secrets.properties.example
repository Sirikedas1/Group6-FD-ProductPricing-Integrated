# ============================================================
#  TEMPLATE ONLY - contains NO real secrets.
#
#  Easiest: run   python integration\setup_local_config.py
#  It creates local-config\dev-secrets.properties for you with random values.
#
#  Manual alternative: copy this file to  local-config\dev-secrets.properties
#  (same folder, without ".example") and replace the two REPLACE_ values.
#  Never share or commit the real dev-secrets.properties.
# ============================================================

# Shared JWT secret for THIS laptop: calculator-service signs login tokens and
# product-service checks them, so both read it from here.
# Letters and digits only, at least 32 characters.
calculator.jwt.secret=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_LETTERS_AND_DIGITS

# product-service MySQL connection (development database only)
product.db.url=jdbc:mysql://127.0.0.1:3306/product_db_dev?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
product.db.username=product_dev
# The password you used in CREATE USER (letters and digits only)
product.db.password=REPLACE_WITH_YOUR_PRODUCT_DEV_PASSWORD
